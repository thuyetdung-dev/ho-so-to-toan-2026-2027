# Sao chép tệp này thành .env.local rồi điền khóa thật (KHÔNG đưa .env.local lên GitHub)
GEMINI_API_KEY=
# Tùy chọn
# GEMINI_MODEL=   # để trống để tự dò mô hình thực tế
# AI_RATE_LIMIT=30  # từ 1 đến 60 lượt/10 phút, lưu quota trong Firestore
# FIREBASE_DATABASE_ID=(default)
# PORT=3000

# Lưu ảnh Cloudinary: bắt buộc cả trên Vercel và máy/VPS
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# FIREBASE_PROJECT_ID=ho-so-to-toan-2026-2027
